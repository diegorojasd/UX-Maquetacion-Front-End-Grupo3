<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- PALETA DE COLORES -->
    <color name="primary">#18434B</color>
    <color name="primary_deep">#0F2B31</color>
    <color name="secondary">#ED532A</color>
    <color name="secondary_soft">#FDDCCF</color>
    <color name="secondary_wash">#FFF5F1</color>

    <!-- NEUTROS Y TEXTO -->
    <color name="background">#F8F9FA</color>
    <color name="surface">#FFFFFF</color>
    <color name="surface_alt">#F1F5F9</color>
    <color name="border">#E2E8F0</color>
    <color name="text_primary">#18434B</color>
    <color name="text_body">#1E293B</color>
    <color name="text_secondary">#64748B</color>
    <color name="text_disabled">#CBD5E1</color>

    <!-- SEMÁNTICOS -->
    <color name="success">#10B981</color>
    <color name="warning">#F59E0B</color>
    <color name="error">#EF4444</color>
    <color name="critical">#ED532A</color>
    <color name="completed">#E2E8F0</color>

    <!-- Text and background per semantic family. CLAUDE.md §4 defines these
         but the baseline only had the base color, so the layouts improvised
         their own greens and oranges. Added as M-07 needs them. -->
    <color name="success_text">#047857</color>
    <color name="success_bg">#D1FAE5</color>
    <color name="critical_text">#9A2F12</color>

    <!-- Derived: peach border of the soft critical chip and the light
         grey-blue "Plan" bar (§4 asks derived tints to be named). -->
    <color name="critical_soft_border">#FBD5C5</color>
    <color name="bar_plan">#CBD8DD</color>


    <!-- TINTES DERIVADOS (M-02) — nombrados como pide CLAUDE.md §4 -->
    <color name="tile_neutral">#E6F0F2</color>
    <color name="tile_secondary">#FFF1EC</color>

    <!-- M-03. §12 describes the active timer card's border as a soft
         orange, not the full #ED532A, and says to take the exact value
         from Figma; using the documented soft token meanwhile. -->
    <color name="timer_alert_border">#FDDCCF</color>

    <style name="ChipEstadoActivo" parent="Widget.MaterialComponents.Chip.Action">
        <item name="chipBackgroundColor">#F1F5F9</item>
        <item name="android:textColor">#18434B</item>
        <item name="android:textSize">12sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:fontFamily">Roboto</item>
        <item name="chipCornerRadius">999dp</item>
        <item name="chipStartPadding">8dp</item>
        <item name="chipEndPadding">8dp</item>
        <item name="chipMinHeight">32dp</item>
    </style>


    <!-- DIMENSIONES BASE -->
    <dimen name="base_width">390dp</dimen>
    <dimen name="margin_lateral">20dp</dimen>
    <dimen name="gutter_interno">12dp</dimen>
    <dimen name="barra_superior">64dp</dimen>
    <dimen name="boton_altura">48dp</dimen>

    <!-- ESCALA DE ESPACIADO -->
    <dimen name="space_4">4dp</dimen>
    <dimen name="space_8">8dp</dimen>
    <dimen name="space_12">12dp</dimen>
    <dimen name="space_16">16dp</dimen>
    <dimen name="space_24">24dp</dimen>
    <dimen name="space_32">32dp</dimen>
    <dimen name="space_48">48dp</dimen>

    <!-- RADIOS -->
    <dimen name="radius_chip">8dp</dimen>
    <dimen name="radius_field">12dp</dimen>
    <dimen name="radius_card">16dp</dimen>
    <dimen name="radius_button">999dp</dimen>
    <dimen name="radius_modal">28dp</dimen>

    <!-- TAMAÑOS DE TEXTO -->
    <dimen name="text_size_title">20sp</dimen>
    <dimen name="text_size_body">14sp</dimen>
    <dimen name="text_size_caption">12sp</dimen>

    <!-- TIPOGRAFÍA -->
    <style name="TextTitle">
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:textSize">@dimen/text_size_title</item>
        <item name="android:fontFamily">Roboto</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="TextBody">
        <item name="android:textColor">@color/text_secondary</item>
        <item name="android:textSize">@dimen/text_size_body</item>
        <item name="android:fontFamily">Roboto</item>
    </style>


    <!-- ESCALA TIPOGRÁFICA DE CLAUDE.md §5
         Los dos estilos de arriba (TextTitle, TextBody) son del baseline y no
         coinciden con ningún tamaño de la tabla; se dejan intactos para no
         alterar M-01, M-08 y M-13. Estos siguen la tabla. -->

    <style name="TextH2">
        <item name="android:fontFamily">@font/roboto_bold</item>
        <item name="android:textSize">22sp</item>
        <item name="android:lineSpacingExtra">6sp</item>
        <item name="android:letterSpacing">-0.009</item>
        <item name="android:textColor">@color/text_primary</item>
    </style>

    <style name="TextItemTitle">
        <item name="android:fontFamily">@font/roboto_bold</item>
        <item name="android:textSize">16sp</item>
        <item name="android:lineSpacingExtra">7sp</item>
        <item name="android:textColor">@color/text_primary</item>
    </style>

    <!-- Row description. §5 lists Body 15/22, but the mockup wraps these
         at Body S; §2 puts the screenshot above this file. -->
    <style name="TextBodyS">
        <item name="android:fontFamily">@font/roboto_regular</item>
        <item name="android:textSize">13sp</item>
        <item name="android:lineSpacingExtra">5sp</item>
        <item name="android:textColor">@color/text_secondary</item>
    </style>

    <style name="TextBodyM">
        <item name="android:fontFamily">@font/roboto_regular</item>
        <item name="android:textSize">15sp</item>
        <item name="android:lineSpacingExtra">7sp</item>
        <item name="android:textColor">@color/text_secondary</item>
    </style>

    <style name="TextCaptionUpper">
        <item name="android:fontFamily">@font/roboto_medium</item>
        <item name="android:textSize">11sp</item>
        <item name="android:letterSpacing">0.073</item>
        <item name="android:textAllCaps">true</item>
        <item name="android:textColor">@color/text_secondary</item>
    </style>

    <!--
        Kicker del encabezado, sobre el título. Estándar de M-01: 12sp
        (@dimen/text_size_caption), roboto_bold, secondary y sin tracking.
        No usar TextCaptionUpper aquí: ese es el caption del sistema (11sp
        con +0.073 de tracking) y lo llevan las etiquetas de sección.
    -->
    <style name="TextScreenKicker">
        <item name="android:fontFamily">@font/roboto_bold</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textSize">@dimen/text_size_caption</item>
        <item name="android:textAllCaps">true</item>
        <item name="android:textColor">@color/secondary</item>
    </style>

    <!--
        Título de pantalla, en la barra superior. Estándar de M-01: 24sp,
        text_primary, roboto_bold y textStyle="bold". M-08 y M-13 lo declaran
        igual en línea. (textStyle es redundante sobre una fuente que ya es
        bold —se comprobó que no cambia el render— y se mantiene sólo para
        que la declaración sea idéntica a la de M-01.)
    -->
    <style name="TextScreenTitle">
        <item name="android:fontFamily">@font/roboto_bold</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textSize">24sp</item>
        <item name="android:textAllCaps">true</item>
        <item name="android:textColor">@color/text_primary</item>
    </style>

    <!-- Low-emphasis action: uppercase, accent, no fill (§9 "Text"). -->
    <style name="TextActionLabel">
        <item name="android:fontFamily">@font/roboto_bold</item>
        <item name="android:textSize">13sp</item>
        <item name="android:letterSpacing">0.06</item>
        <item name="android:textAllCaps">true</item>
        <item name="android:textColor">@color/secondary</item>
    </style>

    <!-- Compact button label, for the small "Escuchar" pill. -->
    <style name="TextButtonLabelSmall">
        <item name="android:fontFamily">@font/roboto_bold</item>
        <item name="android:textSize">15sp</item>
        <item name="android:textColor">@color/text_primary</item>
    </style>

    <!-- Remaining time inside a timer card (§5 Timer 34/38). -->
    <style name="TextTimer">
        <item name="android:fontFamily">@font/roboto_black</item>
        <item name="android:textSize">34sp</item>
        <item name="android:letterSpacing">-0.015</item>
        <item name="android:fontFeatureSettings">tnum</item>
        <item name="android:textColor">@color/text_primary</item>
    </style>

    <!-- Compact card timer. §5 has no size for it; the mockup shows it
         clearly smaller than the active card's. Estimated. -->
    <style name="TextTimerSm">
        <item name="android:fontFamily">@font/roboto_black</item>
        <item name="android:textSize">28sp</item>
        <item name="android:letterSpacing">-0.015</item>
        <item name="android:fontFeatureSettings">tnum</item>
        <item name="android:textColor">@color/text_primary</item>
    </style>

    <style name="TextChip">
        <item name="android:fontFamily">@font/roboto_bold</item>
        <item name="android:textSize">13sp</item>
        <item name="android:textColor">@color/text_primary</item>
    </style>

    <style name="TextButtonLabel">
        <item name="android:fontFamily">@font/roboto_bold</item>
        <item name="android:textSize">16sp</item>
        <item name="android:textColor">@color/surface</item>
    </style>

    <!-- ACCESIBILIDAD -->
    <dimen name="touch_target_min">44dp</dimen>
    <dimen name="focus_halo">3dp</dimen>
    <color name="focus_color">#FDDCCF</color>

    <style name="Theme.App" parent="Theme.AppCompat.Light.NoActionBar"/>



</resources>
