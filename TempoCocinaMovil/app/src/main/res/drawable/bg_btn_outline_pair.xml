<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true"><shape android:shape="rectangle">
        <solid android:color="@color/surface_alt"/>
        <stroke android:width="1dp" android:color="@color/border"/>
        <corners android:radius="@dimen/radius_field"/></shape></item>
    <item android:state_focused="true"><shape android:shape="rectangle">
        <solid android:color="@color/surface"/>
        <stroke android:width="@dimen/focus_halo" android:color="@color/focus_color"/>
        <corners android:radius="@dimen/radius_field"/></shape></item>
    <item><shape android:shape="rectangle">
        <solid android:color="@color/surface"/>
        <stroke android:width="1dp" android:color="@color/border"/>
        <corners android:radius="@dimen/radius_field"/></shape></item>
</selector>
