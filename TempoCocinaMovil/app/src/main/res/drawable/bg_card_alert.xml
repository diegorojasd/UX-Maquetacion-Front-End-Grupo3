<?xml version="1.0" encoding="utf-8"?>
<!-- Active timer card. Tapping it opens the alarm (M-13), so it carries the
     pressed and focused states §8 requires of any control. The default item
     is unchanged, so the card looks exactly as it did.
     §12: the border is a soft orange, not the full #ED532A, and the exact
     value should come from Figma. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/surface_alt"/>
            <stroke android:width="2dp" android:color="@color/secondary"/>
            <corners android:radius="@dimen/radius_card"/>
        </shape>
    </item>
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/surface"/>
            <stroke android:width="@dimen/focus_halo" android:color="@color/focus_color"/>
            <corners android:radius="@dimen/radius_card"/>
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/surface"/>
            <stroke android:width="2dp" android:color="@color/timer_alert_border"/>
            <corners android:radius="@dimen/radius_card"/>
        </shape>
    </item>
</selector>
