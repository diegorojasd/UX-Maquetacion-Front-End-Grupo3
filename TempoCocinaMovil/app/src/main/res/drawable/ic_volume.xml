<?xml version="1.0" encoding="utf-8"?>
<!--
    volume (M-02). Trazado sobre el render de Figma que compartió el equipo:
    cuerpo del altavoz SÓLIDO (cuello rectangular + cono que abre a la derecha)
    y dos ondas en trazo con remate redondo. La versión anterior dibujaba el
    altavoz en contorno, que es lo que no coincidía.

    Medido píxel a píxel sobre la captura (el icono ocupa 36x28 px ahí), no
    exportado del SVG: el MCP de Figma sigue en el límite de llamadas del plan
    Starter. Sustituir por el export real cuando se pueda.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="24dp" android:height="24dp"
    android:viewportWidth="24" android:viewportHeight="24">

    <!-- Cuello + cono, una sola figura rellena -->
    <path
        android:pathData="M1,8.33 L6.5,8.33 L12.61,3.44 L12.61,20.55 L6.5,15.66 L1,15.66 Z"
        android:fillColor="#FF000000" />

    <!-- Onda interior -->
    <path
        android:pathData="M15.36,7.41 Q18.11,11.69 15.36,15.97"
        android:strokeColor="#FF000000"
        android:strokeWidth="1.8"
        android:strokeLineCap="round" />

    <!-- Onda exterior -->
    <path
        android:pathData="M19.33,4.66 Q23.61,11.69 19.33,18.72"
        android:strokeColor="#FF000000"
        android:strokeWidth="1.8"
        android:strokeLineCap="round" />
</vector>
