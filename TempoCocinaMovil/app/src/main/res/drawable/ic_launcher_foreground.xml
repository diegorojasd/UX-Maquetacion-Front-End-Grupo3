<?xml version="1.0" encoding="utf-8"?>
<!--
    Marca de Tempo Cocina, sin el logotipo: el reloj-sarten con su mango,
    las manecillas y las tres lineas de velocidad.
    Trazada a partir de la geometria medida sobre drawable/tempo_cocina_logo.png
    y escalada para caber en el circulo seguro de 66dp del icono adaptativo.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- Anillo del reloj-sarten -->
    <path
        android:pathData="M37.38,64.37a18.49,18.49 0 1,0 36.98,0a18.49,18.49 0 1,0 -36.98,0"
        android:strokeColor="@color/primary"
        android:strokeWidth="4.5" />

    <!-- Mango -->
    <path
        android:pathData="M69.41,50.35L80.69,38.66"
        android:strokeColor="@color/primary"
        android:strokeWidth="4.5"
        android:strokeLineCap="round" />

    <!-- Linea de velocidad 1 -->
    <path
        android:pathData="M27.14,56.37L34.63,56.37"
        android:strokeColor="@color/secondary"
        android:strokeWidth="3.25"
        android:strokeLineCap="round" />

    <!-- Linea de velocidad 2 -->
    <path
        android:pathData="M24.39,64.37L33.38,64.37"
        android:strokeColor="@color/secondary"
        android:strokeWidth="3.25"
        android:strokeLineCap="round" />

    <!-- Linea de velocidad 3 -->
    <path
        android:pathData="M28.38,72.24L34.63,72.24"
        android:strokeColor="@color/secondary"
        android:strokeWidth="3.12"
        android:strokeLineCap="round" />

    <!-- Manecilla: minutero -->
    <path
        android:pathData="M55.87,64.37L55.99,54"
        android:strokeColor="@color/secondary"
        android:strokeWidth="2.75"
        android:strokeLineCap="round" />

    <!-- Manecilla: horario -->
    <path
        android:pathData="M55.87,64.37L62.49,60.62"
        android:strokeColor="@color/secondary"
        android:strokeWidth="2.75"
        android:strokeLineCap="round" />

    <!-- Eje de las manecillas -->
    <path
        android:pathData="M52.62,64.37a3.25,3.25 0 1,0 6.5,0a3.25,3.25 0 1,0 -6.5,0"
        android:fillColor="@color/secondary" />
</vector>
