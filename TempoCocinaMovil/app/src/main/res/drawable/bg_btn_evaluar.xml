<?xml version="1.0" encoding="utf-8"?>
<!-- §12: "Evaluar" is a filled button with ~12-16 radius on a footer, not
     the pill of Button · Primary. Radius from the mockup; confirm in Figma. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true"><shape android:shape="rectangle">
        <solid android:color="@color/primary_deep"/><corners android:radius="@dimen/radius_card"/></shape></item>
    <item android:state_focused="true"><shape android:shape="rectangle">
        <solid android:color="@color/primary"/>
        <stroke android:width="@dimen/focus_halo" android:color="@color/focus_color"/>
        <corners android:radius="@dimen/radius_card"/></shape></item>
    <item><shape android:shape="rectangle">
        <solid android:color="@color/primary"/><corners android:radius="@dimen/radius_card"/></shape></item>
</selector>
