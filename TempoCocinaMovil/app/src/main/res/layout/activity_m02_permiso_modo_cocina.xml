<?xml version="1.0" encoding="utf-8"?>
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background"
    android:fillViewport="true">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/main"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingBottom="@dimen/space_24"
        tools:context=".m02_permiso_ModoCocina">

        <!-- Top app bar -->
        <TextView
            android:id="@+id/tituloModulo"
            style="@style/TextCaptionUpper"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Módulo de sincronización"
            android:textColor="@color/secondary"
            android:fontFamily="@font/roboto_bold"
            android:layout_marginStart="@dimen/margin_lateral"
            android:layout_marginTop="@dimen/space_24"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent" />

        <TextView
            android:id="@+id/tituloPrincipal"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            style="@style/TextScreenTitle"
            android:text="Receta preparacion"
            android:accessibilityHeading="true"
            android:layout_marginStart="@dimen/margin_lateral"
            android:layout_marginTop="@dimen/space_4"
            app:layout_constraintTop_toBottomOf="@id/tituloModulo"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toStartOf="@id/logoTempo" />

        <ImageView
            android:id="@+id/logoTempo"
            android:layout_width="88dp"
            android:layout_height="42dp"
            android:src="@drawable/tempo_cocina_logo"
            android:scaleType="fitCenter"
            android:contentDescription="Tempo Cocina"
            android:layout_marginEnd="@dimen/margin_lateral"
            app:layout_constraintBottom_toBottomOf="@id/tituloPrincipal"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="@id/tituloPrincipal" />

        <!-- 1px separator: CLAUDE.md §7 asks for it on M-02 -->
        <View
            android:id="@+id/separadorBarra"
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:background="@color/border"
            android:layout_marginTop="@dimen/space_16"
            app:layout_constraintTop_toBottomOf="@id/tituloPrincipal"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <!-- Hero: icon tile 64 -->
        <FrameLayout
            android:id="@+id/tileHero"
            android:layout_width="64dp"
            android:layout_height="64dp"
            android:background="@drawable/bg_tile_64"
            android:layout_marginTop="@dimen/space_16"
            app:layout_constraintTop_toBottomOf="@id/separadorBarra"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

            <ImageView
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:layout_gravity="center"
                android:src="@drawable/ic_volume"
                app:tint="@color/text_primary"
                android:importantForAccessibility="no" />
        </FrameLayout>

        <TextView
            android:id="@+id/tituloPermisoAudio"
            style="@style/TextH2"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="Permiso de audio prioritario"
            android:gravity="center"
            android:accessibilityHeading="true"
            android:layout_marginStart="@dimen/margin_lateral"
            android:layout_marginEnd="@dimen/margin_lateral"
            android:layout_marginTop="@dimen/space_16"
            app:layout_constraintTop_toBottomOf="@id/tileHero"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <TextView
            android:id="@+id/descripcionPermisoAudio"
            style="@style/TextBodyM"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="El Modo Cocina necesita sonar con volumen alto aunque tu teléfono esté en silencio o “No Molestar”. Así no se te quemará ningún plato."
            android:gravity="center"
            android:layout_marginStart="@dimen/margin_lateral"
            android:layout_marginEnd="@dimen/margin_lateral"
            android:layout_marginTop="@dimen/space_8"
            app:layout_constraintTop_toBottomOf="@id/tituloPermisoAudio"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <!-- Three permission rows, one layout included three times -->
        <include
            android:id="@+id/filaVolumen"
            layout="@layout/item_permiso_audio"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/margin_lateral"
            android:layout_marginEnd="@dimen/margin_lateral"
            android:layout_marginTop="@dimen/space_16"
            app:layout_constraintTop_toBottomOf="@id/descripcionPermisoAudio"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <include
            android:id="@+id/filaSilencio"
            layout="@layout/item_permiso_audio"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/margin_lateral"
            android:layout_marginEnd="@dimen/margin_lateral"
            android:layout_marginTop="@dimen/space_8"
            app:layout_constraintTop_toBottomOf="@id/filaVolumen"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <include
            android:id="@+id/filaVibracion"
            layout="@layout/item_permiso_audio"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/margin_lateral"
            android:layout_marginEnd="@dimen/margin_lateral"
            android:layout_marginTop="@dimen/space_8"
            app:layout_constraintTop_toBottomOf="@id/filaSilencio"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <!-- Sound test row -->
        <LinearLayout
            android:id="@+id/filaPruebaSonido"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:background="@drawable/bg_card_bordered"
            android:paddingStart="@dimen/space_16"
            android:paddingEnd="@dimen/space_8"
            android:paddingTop="@dimen/space_8"
            android:paddingBottom="@dimen/space_8"
            android:layout_marginStart="@dimen/margin_lateral"
            android:layout_marginEnd="@dimen/margin_lateral"
            android:layout_marginTop="@dimen/space_12"
            app:layout_constraintTop_toBottomOf="@id/filaVibracion"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                style="@style/TextCaptionUpper"
                android:textColor="@color/text_primary"
                android:fontFamily="@font/roboto_bold"
                android:text="Probar sonido de prueba" />

            <LinearLayout
                android:id="@+id/btnEscuchar"
                android:layout_width="wrap_content"
                android:layout_height="48dp"
                android:orientation="horizontal"
                android:gravity="center"
                android:background="@drawable/bg_btn_small"
                android:clickable="true"
                android:focusable="true"
                android:paddingStart="@dimen/space_16"
                android:paddingEnd="@dimen/space_16"
                android:contentDescription="Escuchar sonido de prueba">

                <ImageView
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:src="@drawable/ic_play"
                    app:tint="@color/secondary"
                    android:importantForAccessibility="no" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    style="@style/TextButtonLabelSmall"
                    android:text="Escuchar"
                    android:layout_marginStart="@dimen/space_8" />
            </LinearLayout>
        </LinearLayout>

        <!-- Primary action -->
        <LinearLayout
            android:id="@+id/btnModoCocina"
            android:layout_width="0dp"
            android:layout_height="56dp"
            android:orientation="horizontal"
            android:gravity="center"
            android:background="@drawable/bg_btn_primary"
            android:clickable="true"
            android:focusable="true"
            android:layout_marginStart="@dimen/margin_lateral"
            android:layout_marginEnd="@dimen/margin_lateral"
            android:layout_marginTop="@dimen/space_12"
            app:layout_constraintTop_toBottomOf="@id/filaPruebaSonido"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

            <FrameLayout
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:background="@drawable/bg_circle_secondary">

                <ImageView
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:layout_gravity="center"
                    android:src="@drawable/ic_bell_solid"
                    app:tint="@color/surface"
                    android:importantForAccessibility="no" />
            </FrameLayout>

            <TextView
                style="@style/TextButtonLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Empezar en Modo Cocina"
                android:layout_marginStart="@dimen/space_12" />
        </LinearLayout>

        <!-- Text action -->
        <TextView
            android:id="@+id/btnAhoraNo"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:gravity="center"
            style="@style/TextActionLabel"
            android:text="Ahora no"
            android:background="@drawable/bg_btn_text"
            android:clickable="true"
            android:focusable="true"
            android:layout_marginStart="@dimen/margin_lateral"
            android:layout_marginEnd="@dimen/margin_lateral"
            android:layout_marginTop="@dimen/space_8"
            android:layout_marginBottom="@dimen/space_24"
            app:layout_constraintTop_toBottomOf="@id/btnModoCocina"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />
    </androidx.constraintlayout.widget.ConstraintLayout>
</ScrollView>
