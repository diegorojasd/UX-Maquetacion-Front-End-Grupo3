<?xml version="1.0" encoding="utf-8"?>
<!--
    Comparative bars (M-07). Included three times, filled from the Activity.
    The Plan and Real rows share a fixed label column and a fixed value column
    so every bar starts and ends at the same x (CLAUDE.md §7).
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/bg_card_bordered"
    android:padding="@dimen/space_12">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <FrameLayout
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="@drawable/bg_tile_44">

            <ImageView
                android:id="@+id/iconoProceso"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:layout_gravity="center"
                app:tint="@color/text_primary"
                android:importantForAccessibility="no"
                tools:src="@drawable/ic_pot" />
        </FrameLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:layout_marginStart="@dimen/space_12">

            <TextView
                android:id="@+id/nombreResumen"
                style="@style/TextItemTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                tools:text="Arroz" />

            <TextView
                android:id="@+id/tiemposResumen"
                style="@style/TextBodyS"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                tools:text="15 min est. · 17 min real" />
        </LinearLayout>

        <TextView
            android:id="@+id/chipDesfase"
            style="@style/TextChip"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:paddingStart="@dimen/space_12"
            android:paddingEnd="@dimen/space_12"
            android:paddingTop="@dimen/space_4"
            android:paddingBottom="@dimen/space_4"
            tools:text="+2 min desfase" />
    </LinearLayout>

    <!-- Plan -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginTop="@dimen/space_8">

        <TextView
            style="@style/TextBodyS"
            android:layout_width="44dp"
            android:layout_height="wrap_content"
            android:text="Plan" />

        <ProgressBar
            android:id="@+id/barraPlan"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="0dp"
            android:layout_height="6dp"
            android:layout_weight="1"
            android:max="100"
            android:backgroundTint="@color/surface_alt"
            android:progressTint="@color/bar_plan"
            tools:progress="88" />

        <TextView
            android:id="@+id/valorPlan"
            style="@style/TextBodyS"
            android:layout_width="44dp"
            android:layout_height="wrap_content"
            android:gravity="end"
            android:fontFeatureSettings="tnum"
            tools:text="15m" />
    </LinearLayout>

    <!-- Real -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginTop="@dimen/space_4">

        <TextView
            style="@style/TextBodyS"
            android:layout_width="44dp"
            android:layout_height="wrap_content"
            android:text="Real" />

        <ProgressBar
            android:id="@+id/barraReal"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="0dp"
            android:layout_height="6dp"
            android:layout_weight="1"
            android:max="100"
            android:backgroundTint="@color/surface_alt"
            android:progressTint="@color/primary"
            tools:progress="100" />

        <TextView
            android:id="@+id/valorReal"
            style="@style/TextBodyS"
            android:layout_width="44dp"
            android:layout_height="wrap_content"
            android:gravity="end"
            android:textColor="@color/text_primary"
            android:fontFeatureSettings="tnum"
            tools:text="17m" />
    </LinearLayout>
</LinearLayout>
