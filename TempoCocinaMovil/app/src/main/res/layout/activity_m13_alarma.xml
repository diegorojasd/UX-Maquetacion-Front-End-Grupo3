<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".m13_alarma">
    <!-- Encabezado principal -->
    <TextView
        android:id="@+id/tituloModulo"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="MODO COCINA"
        android:textColor="@color/secondary"
        android:textStyle="bold"
        android:textSize="@dimen/text_size_caption"
        android:fontFamily="@font/roboto_bold"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        android:layout_marginStart="@dimen/margin_lateral"
        android:layout_marginTop="@dimen/space_24"/>

    <TextView
        android:id="@+id/tituloPrincipal"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="ALARMA"
        android:textColor="@color/text_primary"
        android:textStyle="bold"
        android:textSize="24sp"
        android:fontFamily="@font/roboto_bold"
        app:layout_constraintTop_toBottomOf="@id/tituloModulo"
        app:layout_constraintStart_toStartOf="parent"
        android:layout_marginStart="@dimen/margin_lateral"
        android:layout_marginTop="@dimen/space_4"/>

    <!-- Recuadro temporal para el logo -->
    <ImageView
        android:id="@+id/logoTempo"
        android:layout_width="88dp"
        android:layout_height="42dp"
        android:layout_marginEnd="28dp"
        android:src="@drawable/tempo_cocina_logo"
        android:scaleType="fitCenter"
        app:layout_constraintBottom_toBottomOf="@id/tituloPrincipal"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@id/tituloPrincipal"
        app:layout_constraintVertical_bias="1.0"/>


    <!-- TARJETA ALARMNA -->
    <androidx.cardview.widget.CardView
        android:id="@+id/cardReceta"
        android:layout_width="0dp"
        app:layout_constraintWidth_percent="0.9"
        android:layout_height="355dp"
        app:cardCornerRadius="@dimen/radius_card"
        app:cardElevation="0dp"
        app:layout_constraintTop_toBottomOf="@id/tituloPrincipal"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_margin="@dimen/space_16">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:background="@color/primary_deep"
            android:padding="@dimen/space_12">

            <!-- FILA SUPERIOR: MODO COCINA / INMEDIATO -->

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="25dp"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <!-- Modo cocina -->

                <androidx.cardview.widget.CardView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    app:cardCornerRadius="20dp"
                    app:cardBackgroundColor="#355C64"
                    app:cardElevation="0dp">

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="26dp"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:paddingStart="14dp"
                        android:paddingEnd="14dp"
                        android:paddingTop="0dp"
                        android:paddingBottom="0dp">

                        <TextView
                            android:layout_width="10dp"
                            android:layout_height="10dp"
                            android:text="●"
                            android:textColor="@color/secondary"
                            android:textSize="10sp"
                            android:gravity="center"
                            android:includeFontPadding="false" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="16dp"
                            android:text="Modo cocina"
                            android:textColor="@color/surface"
                            android:textSize="14sp"
                            android:fontFamily="@font/roboto_regular"
                            android:layout_marginStart="8dp" />

                    </LinearLayout>

                </androidx.cardview.widget.CardView>

                <!-- Espacio -->

                <View
                    android:layout_width="0dp"
                    android:layout_height="1dp"
                    android:layout_weight="1" />

                <!-- Inmediato -->

                <androidx.cardview.widget.CardView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    app:cardCornerRadius="20dp"
                    app:cardBackgroundColor="@color/secondary"
                    app:cardElevation="0dp">

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="26dp"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:paddingStart="14dp"
                        android:paddingEnd="14dp"
                        android:paddingTop="0dp"
                        android:paddingBottom="0dp">

                        <TextView
                            android:layout_width="18dp"
                            android:layout_height="18dp"
                            android:text="!"
                            android:textColor="@color/secondary"
                            android:textSize="11sp"
                            android:textStyle="bold"
                            android:gravity="center"
                            android:background="@drawable/bg_circle_white" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="INMEDIATO"
                            android:textColor="@color/surface"
                            android:textSize="14sp"
                            android:textStyle="bold"
                            android:fontFamily="@font/roboto_bold"
                            android:layout_marginStart="8dp" />

                    </LinearLayout>

                </androidx.cardview.widget.CardView>

            </LinearLayout>

            <!-- TITULO -->

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginTop="12dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="¡Arroz listo!"
                    android:textColor="@color/surface"
                    android:textSize="30sp"
                    android:textStyle="bold"
                    android:fontFamily="@font/roboto_bold" />

            </LinearLayout>

            <!-- DESCRIPCION -->

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Retirar del fuego inmediatamente y dejar reposar&#10;tapado"
                android:textColor="#D5DDE0"
                android:textSize="14sp"
                android:fontFamily="@font/roboto_regular"
                android:lineSpacingExtra="4dp"
                android:layout_marginTop="8dp" />

            <!-- TEMPORIZADOR -->

            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="98dp"
                android:layout_marginTop="18dp"
                app:cardCornerRadius="12dp"
                app:cardBackgroundColor="#10353C"
                app:cardElevation="0dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:orientation="vertical"
                    android:gravity="center">

                    <!-- Estado -->

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="◷"
                            android:textColor="@color/secondary"
                            android:textSize="22sp"
                            android:fontFamily="@font/roboto_bold" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Tiempo cumplido (+00:14)"
                            android:textColor="@color/secondary"
                            android:textSize="12sp"
                            android:textStyle="bold"
                            android:fontFamily="@font/roboto_bold"
                            android:layout_marginStart="8dp" />

                    </LinearLayout>

                    <!-- Tiempo -->

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="00:00"
                        android:textColor="@color/surface"
                        android:textSize="54sp"
                        android:textStyle="bold"
                        android:fontFamily="@font/roboto_bold"
                        android:includeFontPadding="false"
                        android:layout_marginTop="2dp" />

                </LinearLayout>

            </androidx.cardview.widget.CardView>

            <!-- LINEA DIVISORIA -->

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="#294D54"
                android:layout_marginTop="16dp"
                android:layout_marginBottom="10dp" />

            <!-- INFORMACION INFERIOR -->

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <!-- ESTACION -->

                <androidx.cardview.widget.CardView
                    android:layout_width="0dp"
                    android:layout_height="54dp"
                    android:layout_weight="1"
                    android:layout_marginEnd="8dp"
                    app:cardCornerRadius="16dp"
                    app:cardBackgroundColor="#21474E"
                    app:cardElevation="0dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:paddingStart="12dp"
                        android:paddingEnd="8dp">

                        <TextView
                            android:layout_width="44dp"
                            android:layout_height="44dp"
                            android:text="≡"
                            android:textColor="@color/secondary"
                            android:textSize="25sp"
                            android:textStyle="bold"
                            android:gravity="center"
                            android:background="@drawable/bg_icon_alarm" />

                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:layout_marginStart="10dp">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Estación"
                                android:textColor="#B8C5C8"
                                android:textSize="10sp"
                                android:fontFamily="@font/roboto_regular" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Estación 1 · Olla"
                                android:textColor="@color/surface"
                                android:textSize="12sp"
                                android:textStyle="bold"
                                android:fontFamily="@font/roboto_bold"
                                android:layout_marginTop="0dp" />

                        </LinearLayout>

                    </LinearLayout>

                </androidx.cardview.widget.CardView>


                <!-- RECETA -->

                <androidx.cardview.widget.CardView
                    android:layout_width="0dp"
                    android:layout_height="54dp"
                    android:layout_weight="1"
                    android:layout_marginStart="8dp"
                    app:cardCornerRadius="16dp"
                    app:cardBackgroundColor="#21474E"
                    app:cardElevation="0dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:paddingStart="12dp"
                        android:paddingEnd="8dp">

                        <TextView
                            android:layout_width="44dp"
                            android:layout_height="44dp"
                            android:text="▤"
                            android:textColor="@color/secondary"
                            android:textSize="22sp"
                            android:textStyle="bold"
                            android:gravity="center"
                            android:background="@drawable/bg_icon_alarm" />

                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:layout_marginStart="10dp">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Receta"
                                android:textColor="#B8C5C8"
                                android:textSize="10sp"
                                android:fontFamily="@font/roboto_regular" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Pollo al horno"
                                android:textColor="@color/surface"
                                android:textSize="12sp"
                                android:textStyle="bold"
                                android:fontFamily="@font/roboto_bold"
                                android:layout_marginTop="2dp" />

                        </LinearLayout>

                    </LinearLayout>

                </androidx.cardview.widget.CardView>

            </LinearLayout>

        </LinearLayout>

    </androidx.cardview.widget.CardView>

    <!-- SIGUIENTE PROCESO -->
    <androidx.cardview.widget.CardView
        android:id="@+id/cardSiguienteProceso"
        android:layout_width="0dp"
        app:layout_constraintWidth_percent="0.9"
        android:layout_height="84dp"
        android:layout_marginTop="@dimen/space_16"
        app:cardCornerRadius="16dp"
        app:cardElevation="0dp"
        android:foreground="?attr/selectableItemBackground"
        app:layout_constraintTop_toBottomOf="@id/cardReceta"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingStart="@dimen/space_24"
            android:paddingEnd="@dimen/space_24"
            android:background="@drawable/bg_card">

            <!-- Icono -->
            <ImageView
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:src="@drawable/ic_thunder"
                android:backgroundTint="#F1F5F9"
                android:padding="6dp"
                android:layout_marginEnd="12dp"
                android:background="@drawable/bg_icono_proceso"/>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:layout_marginStart="12dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Siguiente proceso"
                    android:textColor="@color/text_secondary"
                    android:textSize="12sp"
                    android:fontFamily="@font/roboto_regular" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Salsa en 02:45 min"
                    android:textColor="@color/text_primary"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:fontFamily="@font/roboto_bold" />
            </LinearLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Paso 2 de 3"
                android:textColor="@color/text_secondary"
                android:textSize="12sp"
                android:fontFamily="@font/roboto_regular" />
        </LinearLayout>
    </androidx.cardview.widget.CardView>

    <!-- BOTONES DE ACCIÓN -->
    <Button
        android:id="@+id/btnDetener"
        android:layout_width="0dp"
        app:layout_constraintWidth_percent="0.9"
        android:layout_height="56dp"
        android:layout_marginTop="@dimen/space_16"
        android:text="Detener alarma"
        android:textAllCaps="false"
        android:textColor="@color/surface"
        android:textStyle="bold"
        android:fontFamily="@font/roboto_bold"
        android:background="@drawable/bg_btn_detener"
        app:layout_constraintTop_toBottomOf="@id/cardSiguienteProceso"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <Button
        android:id="@+id/btnPosponer"
        android:layout_width="0dp"
        app:layout_constraintWidth_percent="0.9"
        android:layout_height="56dp"
        android:layout_marginTop="@dimen/space_8"
        android:text="Posponer 2 min"
        android:textAllCaps="false"
        android:textColor="@color/text_primary"
        android:textStyle="bold"
        android:fontFamily="@font/roboto_bold"
        android:background="@drawable/bg_btn_posponer"
        android:backgroundTint="@null"
        app:layout_constraintTop_toBottomOf="@id/btnDetener"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <TextView
        android:id="@+id/colaAlarmas"
        android:layout_width="0dp"
        app:layout_constraintWidth_percent="0.9"
        android:layout_height="wrap_content"
        android:text="VER COLA DE ALARMAS (3 ACTIVAS)"
        android:textColor="@color/text_primary"
        android:textSize="12sp"
        android:textStyle="bold"
        android:fontFamily="@font/roboto_bold"
        android:layout_marginTop="@dimen/space_12"
        app:layout_constraintTop_toBottomOf="@id/btnPosponer"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:gravity="center" />

</androidx.constraintlayout.widget.ConstraintLayout>